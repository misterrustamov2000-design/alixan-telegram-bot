# Telegram Bot Token (@BotFather dan olingan token)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Admin Telegram ID raqamlari (vergul bilan ajratilgan, masalan: 12345678,98765432)
# O'z ID raqamingizni bilish uchun botga /admin deb yozsangiz bot sizning ID raqamingizni ko'rsatadi
ADMIN_IDS=

# Mini App URL (masalan, Vercel, Netlify yoki GitHub Pages da yuklangan link)
MINI_APP_URL=https://t.me/alixan_fastfood_bot/app

# Google Maps havolasi
MAPS_URL=https://maps.app.goo.gl/Fhy5qVkYocFi2C92A

# Restoran koordinatalari (Kattaqo'rg'on)
LOCATION_LATITUDE=39.897368
LOCATION_LONGITUDE=66.257523
